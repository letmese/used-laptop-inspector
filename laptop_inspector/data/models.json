    {
      "id": "thinkpad-w520",
      "brand": "Lenovo",
      "family": "ThinkPad W520",
      "years": "2011",
      "match": ["thinkpad\\s*w520", "^42(42|43|62|63|70|71|76|82|83|84)"],
      "igpu": "Intel HD Graphics 3000",
      "dgpu": ["NVIDIA Quadro 1000M", "NVIDIA Quadro 2000M"],
      "dgpu_standard": false,
      "notes": "Quadro optional from factory; many units are iGPU-only. Optimus. dGPU is commonly disabled in BIOS when the MXM card or its power rail fails."
    },
